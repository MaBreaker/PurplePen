<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:PurplePen.ViewModels.Livelox"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:assets="using:AvPurplePen.Livelox"
		xmlns:resx="using:AvPurplePen"
		mc:Ignorable="d" d:DesignWidth="640"
		x:Class="AvPurplePen.Views.Livelox.PublishToLiveloxDialog"
        x:DataType="vm:PublishToLiveloxDialogViewModel"
        x:CompileBindings="True"
		xmlns:avutil="using:AvUtil"
		Title="{x:Static assets:UIText.Livelox_Publish_title_Text}"
		Width="640" SizeToContent="Height"
		Icon="/Assets/transparent.ico"
		CanResize="True"
		WindowStartupLocation="CenterOwner"
		Background="#F0F0F0">

	<DockPanel LastChildFill="False" Margin="0">

		<!-- Info section with title, always visible -->
		<StackPanel DockPanel.Dock="Top" Margin="20,20,20,15" Spacing="10">
			<!-- Logo panel at top: white background, draws the Livelox logo.
				 The custom drawing is done in the code-behind Paint handler. -->
			<Grid Margin="20,0,20,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="0">
			<avutil:SkiaDrawingView Grid.Row="0" Grid.Column="0" x:Name="liveloxPanel"
					DockPanel.Dock="Top"
					Height="96"
					Width="96"
					Paint="LiveloxPanel_Paint"/>
			
			<TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static assets:UIText.Livelox_Publish_informationLabel_Text}"
						TextWrapping="Wrap"
						Foreground="#000"
						FontSize="12" />
			</Grid>
		</StackPanel>

		<!-- Main content area -->
		<Grid DockPanel.Dock="Top" Margin="20,0,20,15" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

			<!-- Consent section -->
			<Border Grid.Row="0"
					Background="#E8F4F8"
					BorderBrush="#4A90E2"
					BorderThickness="1"
					CornerRadius="4"
					Padding="15"
					Margin="0,0,0,15"
					IsVisible="{Binding ShowConsentPanel}">
				<StackPanel Spacing="8">
					<TextBlock TextWrapping="Wrap"
							   Text="{x:Static assets:UIText.Livelox_Consent_informationLabel_Text}"
							   Foreground="#000"
							   FontSize="14" />

					<!-- Remember consent option -->
					<CheckBox Name="RememberConsentCheckBox"
							  IsChecked="{Binding RememberConsent}"
							  Content="{x:Static assets:UIText.Livelox_Consent_rememberConsentCheckBox_Text}"
							  Foreground="#333"
							  Margin="0,10,0,0" />
				</StackPanel>
			</Border>
			
			<!-- Resolution section -->
			<Border Grid.Row="1"
					Background="White"
					CornerRadius="4"
					Padding="15"
					Margin="0,0,0,15"
					IsVisible="{Binding ShowSettingsPanel}">
				<StackPanel Spacing="10">
					<CheckBox Name="ShowSettingsCheckBox"
							  IsChecked="{Binding ShowSettings}"
							  Content="{x:Static assets:UIText.Livelox_Publish_showSettingsCheckBox_Text}" />

					<!--
					<StackPanel IsVisible="{Binding ShowSettings}" Orientation="Horizontal" Spacing="8">
						<TextBlock Text="{x:Static assets:UIText.Livelox_Publish_resolutionLabel_Text}"
								   FontWeight="SemiBold"
								   Foreground="#333"
								   DockPanel.Dock="Left" />
						<TextBox Name="ResolutionTextBox"
								 Text="{Binding Resolution}"
								 DockPanel.Dock="Right"
								 Padding="8"
								 BorderThickness="1"
								 BorderBrush="#DDD" />
					</StackPanel>
				    <DockPanel IsVisible="{Binding ShowSettings}" LastChildFill="False" VerticalSpacing="8" HorizontalSpacing="8">

						<TextBlock Text="{x:Static assets:UIText.Livelox_Publish_resolutionLabel_Text}"
								   FontWeight="SemiBold"
								   Foreground="#333"
								   DockPanel.Dock="Left" />
						<TextBox Name="ResolutionTextBox"
								 Text="{Binding Resolution}"
								 DockPanel.Dock="Right"
								 Padding="8"
								 BorderThickness="1"
								 BorderBrush="#DDD" />
					</DockPanel>
					-->
					<Panel IsVisible="{Binding ShowSettings}">
						<TextBlock Text="{x:Static assets:UIText.Livelox_Publish_resolutionLabel_Text}"
								   FontWeight="SemiBold"
								   Foreground="#333" />
						<TextBox Name="ResolutionTextBox"
								 Text="{Binding Resolution}"
								 HorizontalAlignment="Right"
								 MinWidth="80" 
								 Padding="8"
								 BorderThickness="1"
								 BorderBrush="#DDD" />
					</Panel>
				</StackPanel>
			</Border>

			<!-- User selection section -->
			<Border Grid.Row="2"
					Background="White"
					CornerRadius="4"
					Padding="15"
					Margin="0,0,0,15"
					IsVisible="{Binding ShowUserPanel}">
				<StackPanel Spacing="10">
					<Panel>
						<TextBlock Text="{x:Static assets:UIText.Livelox_Publish_userLabel_Text}"
								   FontWeight="SemiBold"
								   Foreground="#333" />
						<ComboBox Name="UserComboBox"
								  ItemsSource="{Binding AvailableUsers}"
								  SelectedItem="{Binding SelectedUser}"
								  HorizontalAlignment="Right"
								  Padding="8"
								  BorderThickness="1"
								  BorderBrush="#DDD">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding FullName}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Panel>
				</StackPanel>
			</Border>

			<!-- Existing event section -->
			<Border Grid.Row="3"
					Background="#E8F4F8"
					BorderBrush="#4A90E2"
					BorderThickness="1"
					CornerRadius="4"
					Padding="15"
					Margin="0,0,0,15"
					IsVisible="{Binding ShowExistingEventPanel}">
				<StackPanel Spacing="8">
					<TextBlock Text="{x:Static assets:UIText.Livelox_Publish_existingEventGroupBox_Text}"
							   FontWeight="SemiBold"
							   Foreground="#333" />
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="5">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#666" />
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EventName}" Foreground="#333" />

						<TextBlock Grid.Row="1" Grid.Column="0" Text="Organizers:" Foreground="#666" />
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EventOrganizers}" Foreground="#333" />

						<TextBlock Grid.Row="2" Grid.Column="0" Text="Time:" Foreground="#666" />
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EventTimeInterval}" Foreground="#333" />
					</Grid>
				</StackPanel>
			</Border>

			<!-- Loading indicator -->
			<Border Grid.Row="4"
					CornerRadius="4"
					Padding="15"
					IsVisible="True">
				<StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center">
					<ProgressBar IsIndeterminate="{Binding ProgressLoading}" 
								 Height="4"
								 Minimum="0"
								 Maximum="1"
								 Value="{Binding ProgressValue}" 
								 Foreground="{Binding ProgressColor}" 
								 ShowProgressText="{Binding ProgressError}"
								 ProgressTextFormat="ERROR"/>
					<TextBlock Text="{Binding ProgressMessage}"
							   TextAlignment="Center"
							   TextWrapping="Wrap"
							   Foreground="#666" />
				</StackPanel>
			</Border>
		</Grid>

		<!-- Bottom button section -->
		<StackPanel DockPanel.Dock="Bottom"
					Orientation="Horizontal"
					Spacing="10"
					HorizontalAlignment="Right"
					Margin="20,0,20,20">
			
			<Button Name="ContinueButton"
					Content="{x:Static assets:UIText.Livelox_Consent_continueButton_Text}"
					IsCancel="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowContinueButton}"
					Command="{Binding ContinueCommand}" />
			
			<Button Name="UpdateButton"
					Content="{x:Static assets:UIText.Livelox_Publish_updateEventButton_Text}"
					IsDefault="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowUpdateButton}"
					IsEnabled="{Binding CanPublish}"
					Command="{Binding UpdateEventCommand}" />

			<Button Name="PublishOtherButton"
					Content="{x:Static assets:UIText.Livelox_Publish_publishToOtherEventButton_Text}"
					IsDefault="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowPublishOtherButton}"
					IsEnabled="{Binding CanPublish}"
					Command="{Binding PublishCommand}" />

			<Button Name="PublishButton"
					Content="{x:Static assets:UIText.Livelox_Publish_publishButton_Text}"
					IsDefault="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowPublishButton}"
					IsEnabled="{Binding CanPublish}"
					Command="{Binding PublishCommand}" />

			<Button Name="OkButton"
					Content="{x:Static assets:UIText.Livelox_Publish_okButton_Text}"
					IsDefault="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowOkButton}"
					Command="{Binding OkCommand}" />
					<!-- Click="CancelButton_Click" -->
			
			<Button Name="CancelButton"
					Content="{x:Static assets:UIText.Livelox_Publish_cancelButton_Text}"
					IsCancel="True"
					Padding="15,8"
					MinWidth="80"
					IsVisible="{Binding ShowCancelButton}"
					Command="{Binding CancelCommand}" />
					<!-- Click="CancelButton_Click" -->
		</StackPanel>
	</DockPanel>
</Window>