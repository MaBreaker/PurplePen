<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:PurplePen.ViewModels.Livelox"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:assets="using:AvPurplePen.Livelox"
		xmlns:resx="using:AvPurplePen"
		mc:Ignorable="d" d:DesignWidth="500" 
		x:Class="AvPurplePen.Views.Livelox.ConsentRedirectionDialog"
        x:DataType="vm:ConsentRedirectionDialogViewModel"
        x:CompileBindings="True"
		Title="{x:Static assets:UIText.Livelox_Consent_title_Text}"
		Width="500" SizeToContent="Height"
		Icon="/Assets/transparent.ico"
		CanResize="True"
		WindowStartupLocation="CenterOwner"
		Background="#F0F0F0">

	<StackPanel Margin="25" Spacing="20">
		<!-- Title -->
		<TextBlock Text="Authorization Required"
				   FontSize="18"
				   FontWeight="Bold"
				   Foreground="#333" />

		<!-- Description -->
		<TextBlock TextWrapping="Wrap"
				   Text="{x:Static assets:UIText.Livelox_Consent_informationLabel_Text}"
				   Foreground="#000"
				   FontSize="14" />

		<!-- Remember consent option -->
		<CheckBox Name="RememberConsentCheckBox"
				  IsChecked="{Binding RememberConsent}"
				  Content="{x:Static assets:UIText.Livelox_Consent_rememberConsentCheckBox_Text}"
				  Foreground="#333"
				  Margin="0,10,0,0" />

		<!-- Spacer -->
		<Border Height="1" Background="#E0E0E0" Margin="0,10,0,10" />

		<!-- Buttons -->
		<StackPanel Orientation="Horizontal"
					Spacing="10"
					HorizontalAlignment="Right"
					Margin="0,10,0,0">
			<Button Name="CancelButton"
					Content="{x:Static assets:UIText.Livelox_Consent_cancelButton_Text}"
					IsCancel="True"
					Padding="15,8"
					Width="90"
					Background="#F0F0F0"
					BorderBrush="#CCC" />

			<Button Name="ContinueButton"
					Content="{x:Static assets:UIText.Livelox_Consent_continueButton_Text}"
					IsDefault="True"
					Padding="15,8"
					Width="90"
					Background="#4A90E2"
					Foreground="White"
					Click="ContinueButton_Click" />
		</StackPanel>
	</StackPanel>
</Window>